include:
  - "*.md"
  - "*.txt"
  - "*.json"
  - "*.yml"
  - "*.yaml"
  - "*.sh"
  - "*.mdc"
  - ".cursorrules"
  - ".windsurfrules"
  - ".gitingest"

exclude:
  - "node_modules/**"
  - ".git/**"
  - "*.png"
  - "*.svg"
  - "*.jpg"
  - "*.jpeg"
  - "*.html"
  - ".DS_Store"

output:
  format: markdown
  include_tree: true
  include_summary: true
