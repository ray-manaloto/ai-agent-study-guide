{
  "name": "AI Agent Study Guide",
  "description": "Documentation repository for studying OpenAI Codex-RS architecture",
  "contextProviders": [
    {
      "name": "file",
      "params": {
        "files": [
          "AGENTS.md",
          "llms-full.txt",
          "docs/WORKFLOWS.md",
          "docs/architecture-diagram.md"
        ]
      }
    }
  ],
  "customCommands": [
    {
      "name": "verify-mermaid",
      "description": "Verify Mermaid diagrams render correctly",
      "command": "./scripts/render-diagrams.sh"
    }
  ],
  "docs": [
    {
      "name": "Codex-RS",
      "url": "https://github.com/openai/codex/tree/main/codex-rs"
    }
  ],
  "rules": [
    "Documentation-only repository",
    "Read docs/WORKFLOWS.md for task execution",
    "Read docs/AGENTS.md when working in docs/",
    "Use Mermaid for diagrams",
    "TUI communicates directly with ThreadManager, NOT MessageProcessor"
  ]
}
